{
  "name": "@obrametrik/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:tunnel": "expo start --tunnel",
    "build": "expo export --platform web",
